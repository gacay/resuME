# Copy this file to .env.local and fill in the key(s) for whichever providers
# you point the models at in lib/models.ts.

# Anthropic — get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter (optional) — only needed if a task in lib/models.ts uses an
# "openrouter" provider. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
